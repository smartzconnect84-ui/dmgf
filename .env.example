# ============================================================
# DMGF — Deesire Moore Grace Foundation
# Supabase integration environment variables
# ============================================================
# These values come from your EXISTING Supabase project.
# Do NOT create a new project or copy values into this file manually —
# set them under Backend → Secrets in the Vercel dashboard, and they
# will be injected at build/runtime. The template ships with placeholders
# that are never read by the live application until configured.

# ---- Server-side (server functions, SSR, admin operations) ----
# URL of your existing Supabase project (https://<project>.supabase.co)
SUPABASE_URL="https://your-project.supabase.co"
# Service role key — NEVER exposed to the browser. Used only by
# server-side functions and SSR, never in client code.
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"

# ---- Client-side (browser-exposed, Vite) ----
# Publishable (anon) key for the browser client.
# Also accepted: VITE_SUPABASE_ANON_KEY (legacy) and NEXT_PUBLIC_SUPABASE_ANON_KEY.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your_publishable_key"

# ---- Owner provisioning (used by the sign-in page) ----
# Initial owner password. Set OWNER_INITIAL_PASSWORD under Backend → Secrets
# to override the default without a code change.
OWNER_INITIAL_PASSWORD="Deesire@2024"
